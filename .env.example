# Copy this file to .env and replace every replace-me value.

# Initial administrator account. Required before the first startup.
TRUSTEDRAG_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Paths (relative defaults work when the service starts in the repository root)
TRUSTEDRAG_AUTH_DB_PATH=./data/trustedrag_auth.sqlite3
TRUSTEDRAG_NAME_MAP_PATH=./data/name2id.json
TRUSTEDRAG_STORAGE_ROOT=./data/rag_storage
TRUSTEDRAG_CORPUS_ROOT=./data/corpus
TRUSTEDRAG_CORPUS_PENDING_ROOT=./data/corpus/.pending
TRUSTEDRAG_OUTPUT_ROOT=./data/output
TRUSTEDRAG_BUILD_ROOT=./data/.trustedrag-builds
TRUSTEDRAG_MODEL_SETTINGS_PATH=./data/webapp_model_settings.json
TRUSTEDRAG_PROXY_CONFIG_PATH=./config/proxy.yaml

# Generation model (OpenAI-compatible)
RAG_LLM_BASE_URL=https://api.example.com/v1
RAG_LLM_API_KEY=replace-me
RAG_LLM_MODEL=replace-me

# Embedding model (OpenAI-compatible)
RAG_EMBEDDING_BASE_URL=https://api.example.com/v1
RAG_EMBEDDING_API_KEY=replace-me
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIM=3072

# Retrieval
RAG_QUERY_MODE=hybrid
RAG_TOP_K=40
RAG_CHUNK_TOP_K=20
RAG_MAX_SOURCES=8
RAG_MAX_SOURCE_CHARS=2400
RAG_MAX_CONTEXT_CHARS=36000
RAG_ROUTE_SHORTLIST_SIZE=8
RAG_ROUTE_MIN_SCORE=0.20
RAG_ROUTE_MIN_MARGIN=0.025
RAG_EVIDENCE_PARSE_MAX_BYTES=16777216
RAG_EVIDENCE_MAX_CANDIDATES=8
RAG_EVIDENCE_MIN_SCORE=8.0
RAG_EVIDENCE_MIN_MARGIN=1.5
RAG_EVIDENCE_EXCERPT_CHARS=900
RAG_EVIDENCE_CACHE_TTL_SECONDS=300
RAG_CORPUS_PREVIEW_ROWS=120
RAG_CORPUS_MAX_CELL_CHARS=4000

# Knowledge-base build queue
TRUSTEDRAG_KB_BUILD_ENABLED=true
TRUSTEDRAG_BUILD_MAX_UPLOAD_BYTES=104857600
TRUSTEDRAG_BUILD_HISTORY_LIMIT=100
TRUSTEDRAG_BUILD_BATCH_LIMIT=20
TRUSTEDRAG_BUILD_TIMEOUT_SECONDS=2700
TRUSTEDRAG_BUILD_HEARTBEAT_TIMEOUT_SECONDS=180
TRUSTEDRAG_BUILD_PROGRESS_POLL_SECONDS=1
TRUSTEDRAG_BUILD_NICE_LEVEL=5
TRUSTEDRAG_BUILD_EMBEDDING_MAX_ASYNC=2
TRUSTEDRAG_BUILD_EMBEDDING_BATCH_NUM=10
TRUSTEDRAG_BUILD_EMBEDDING_TIMEOUT_SECONDS=120

# Web/API (used by the included scripts and deployment templates)
TRUSTEDRAG_API_HOST=127.0.0.1
TRUSTEDRAG_API_PORT=5051

# Optional compatibility variables used by the standalone examples
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
LLM_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
VERBOSE=false
LIBREOFFICE_CONVERT_TIMEOUT=600
CUDA_VISIBLE_DEVICES=
